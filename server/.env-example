# Copy this file to .env and fill in your own values.

# Port the Express server listens on (defaults to 3000)
PORT=3000

# URL of the React client allowed by CORS
CLIENT_URL=http://localhost:5173

# MongoDB connection string, including the database name
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/carverse?retryWrites=true&w=majority

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=your_jwt_secret

# Geoapify API key for the service-center search
MAPS_API_KEY=your_geoapify_api_key

# Cloudinary (car image uploads) - from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
